# Copy to .env and fill in real values. Never commit .env.
#
# This file is the canonical environment contract, but every value below is a
# random placeholder. Do not copy values from a real deployment into it.
#   Required  = no default; startup fails without it
#   Optional  = safe default shown
#   Prod      = required only when NODE_ENV=production

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

MONGODB_URI=mongodb://127.0.0.1:27017/lynky_example
# http(s), no query/fragment/credentials; a subpath is allowed.
PUBLIC_URL=http://localhost:5001
# At least 32 characters. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=a9Pz/oGv9YZMsHZ7xkpchPwfrMWW7dr9eRdupIu8CBI=
EXPIRATION_DAYS=3

# ---------------------------------------------------------------------------
# Server (optional; defaults shown)
# ---------------------------------------------------------------------------

PORT=5001
NODE_ENV=development
# Prod: required when NODE_ENV=production; optional in development/test.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Short codes (optional; defaults shown)
# ---------------------------------------------------------------------------

MIN_CODE_LENGTH=4
MAX_CODE_LENGTH=6
MAX_CODE_ATTEMPTS=10

# ---------------------------------------------------------------------------
# Input limits (optional; defaults shown)
# ---------------------------------------------------------------------------

MAX_URL_LENGTH=640

# ---------------------------------------------------------------------------
# URL validation (optional; default false)
# ---------------------------------------------------------------------------

# Allow hosts under private public-suffix entries (*.eu.org, *.pp.ua,
# GitHub-Pages-style free spaces). Off by default: those spaces are
# abuse-ridden, and the toggle also controls whether private-PSL hosts count
# as registrable domains at all.
ALLOW_PRIVATE_SUFFIXES=false

# ---------------------------------------------------------------------------
# Config engine (optional; defaults shown)
# ---------------------------------------------------------------------------

# open (default): continue creating links with degraded readiness if the
# blocklist artifact cannot load. closed: reject create traffic in that state.
BLOCKLIST_FAILURE_MODE=open
# Development-only full Zod validation of compiled artifacts.
CONFIG_FULL_RUNTIME_VALIDATION=false

# Optional URLhaus/Hagezi-style blocklists:
# drop *.txt files into config/blocklists/ or run `npm run blocklists:fetch`.
# `config/blocklists/sources.json` declares required/min-entry rules; fetch
# lists before building because `hagezi-list-light.txt` is required.

# ---------------------------------------------------------------------------
# Upstash Redis (required in production; development/test use memory)
# ---------------------------------------------------------------------------

# Leave these unset in development or test. Production startup fails without
# them. Create the database at https://console.upstash.com/redis.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here

# ---------------------------------------------------------------------------
# Global request limit (optional; default 5000)
# ---------------------------------------------------------------------------

# Applies to every route, including /health and /ready. Uptime monitors
# consume the same global budget.
GLOBAL_RATE_LIMIT_PER_HOUR=5000
# Per-IP create-route limit (15-minute window; default 100).
LINK_RATE_LIMIT_PER_15_MIN=100

# ---------------------------------------------------------------------------
# Benchmark instrumentation (development only; default false)
# ---------------------------------------------------------------------------

# Adds per-stage create timings as response headers. Production refuses to
# start with this enabled.
SERVER_STAGE_TIMINGS=false

# ---------------------------------------------------------------------------
# Hot-link cache + approximate click accounting (optional; defaults shown)
# ---------------------------------------------------------------------------

HOT_VISIT_THRESHOLD=4
HOT_WINDOW_SECONDS=300
HOT_CACHE_TTL_SECONDS=900
CLICK_STORAGE_MODE=hybrid
CLICK_EXACT_BELOW_PER_HOUR=2000
CLICK_FLUSH_EVERY_N=10
CLICK_FLUSH_INTERVAL_MS=60000
CLICK_PENDING_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Sysadmin dashboard (optional; disabled by default)
# ---------------------------------------------------------------------------

# Generate the hash outside the app with:
#   npm run admin:hash-password -- '<local-password>'
SYSADMIN_ENABLED=false
# SYSADMIN_USERNAME=example.admin
# SYSADMIN_PASSWORD_HASH=yourpasswordhashhere

# ---------------------------------------------------------------------------
# API keys (optional; defaults shown)
# ---------------------------------------------------------------------------

API_KEY_MONTHLY_LIMIT=10000
# Integer 16-512. Keys are exactly this many base64url characters; changing
# this value invalidates keys issued at the previous length.
API_KEY_LENGTH=45
