# Copy to .env and fill in real values. Never commit .env.

# Required
MONGODB_URI=mongodb://127.0.0.1:27017/lynky
PUBLIC_URL=http://localhost:5001
ENCRYPTION_KEY=replace-with-a-long-random-secret
EXPIRATION_DAYS=3

# Server
PORT=5001
NODE_ENV=development
# Required when NODE_ENV=production (lowercase or uppercase both work)
FRONTEND_URL=http://localhost:5173

# Short codes
MIN_CODE_LENGTH=4
MAX_CODE_LENGTH=6
MAX_CODE_ATTEMPTS=10

# Input limits
MAX_URL_LENGTH=640

# API keys
API_KEY_MONTHLY_LIMIT=10000
API_KEY_LENGTH=45
