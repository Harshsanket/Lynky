{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://short-lynky-hs.vercel.app/api/v1/:path*"
    },
    {
      "source": "/sysadmin/api/:path*",
      "destination": "https://short-lynky-hs.vercel.app/sysadmin/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
