# Copy to .env.local for local development. Never commit real values.

# Backend API base URL. Must include the version prefix.
VITE_API_URL=http://localhost:5001/api/v1

# Optional: iOS Shortcut download link shown in the docs.
VITE_IOS_SHORTCUT=

# Optional: monthly quota label shown in the API docs (backend default: 10000).
VITE_API_KEY_MONTHLY_LIMIT=10000
