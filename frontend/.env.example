# Copy to .env.local for local development. Never commit real values.
#
# Vite precedence: .env < .env.local < .env.[mode] < .env.[mode].local.
# Later files override earlier files. Keep VITE_API_KEY_LENGTH and
# VITE_MAX_URL_LENGTH aligned with backend API_KEY_LENGTH and MAX_URL_LENGTH.

# Required: backend API base URL, including the version prefix.
VITE_API_URL=http://localhost:5001/api/v1

# Optional: public site origin used for canonical/Open Graph URLs and the
# 404 page. Defaults to the browser origin when unset.
VITE_SITE_URL=http://localhost:5173

# Optional: public short-link origin shown in documentation examples.
VITE_SHORT_URL=http://localhost:5001

# Required for request-shape parity with the backend.
VITE_API_KEY_LENGTH=45
VITE_MAX_URL_LENGTH=640
